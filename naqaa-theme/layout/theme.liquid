<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#0B3846">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Jost:wght@400;500;600&family=Amiri&display=swap">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  {{ content_for_header }}

  {%- if template.name == 'product' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | truncate: 500 | json }},
        "brand": { "@type": "Brand", "name": "Naqaa" },
        {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
        "offers": [
          {%- for variant in product.variants -%}
            {
              "@type": "Offer",
              "sku": {{ variant.sku | json }},
              "price": {{ variant.price | divided_by: 100.0 | json }},
              "priceCurrency": {{ cart.currency.iso_code | json }},
              "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "url": {{ request.origin | append: variant.url | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
  {%- if template.name == 'index' -%}
    <script type="application/ld+json">
      { "@context": "https://schema.org", "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ request.origin | json }} }
    </script>
  {%- endif -%}
</head>

<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">Aller au contenu</a>
  {% section 'announcement' %}
  {% section 'header' %}

  <main id="main" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% render 'cart-drawer' %}
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    window.Naqaa = {
      routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }}, cartChange: {{ routes.cart_change_url | json }}, root: {{ routes.root_url | json }} },
      money: {{ shop.money_format | json }},
      upsell: [
        {%- assign up = collections[settings.upsell_collection] -%}
        {%- if up != blank -%}
          {%- for p in up.products limit: 6 -%}
            { "id": {{ p.selected_or_first_available_variant.id }}, "handle": {{ p.handle | json }}, "title": {{ p.title | split: '·' | first | strip | json }}, "price": {{ p.price }}, "img": {{ p.featured_image | image_url: width: 200 | json }}, "available": {{ p.available }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ]
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
