<header class="page-head">
  <div class="jhead__ros" aria-hidden="true">{% render 'rosette' %}</div>
  <div class="wrap">
    <p class="crumbs"><a href="{{ routes.root_url }}">Accueil</a> / {{ blog.title }}</p>
    <h1 class="h-display grad-text">{{ section.settings.title | default: blog.title }}</h1>
    <p class="lede" style="margin-top:16px">{{ section.settings.text }}</p>
    {%- if blog.all_tags.size > 0 -%}
      <div class="tags">
        <a href="{{ blog.url }}"{% unless current_tags %} style="background:var(--c-petrol);color:#fff"{% endunless %}>Tous</a>
        {%- for tag in blog.all_tags -%}{%- if tag == 'Guide' or tag == 'Ihram' or tag == 'Médine' or tag == 'Visites' or tag == 'Préparation' -%}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} style="background:var(--c-petrol);color:#fff"{% endif %}>{{ tag }}</a>{%- endif -%}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</header>
<section class="section" style="padding-top:64px">
  <div class="wrap">
    {%- paginate blog.articles by 9 -%}
      <div class="jgrid">{%- for article in blog.articles -%}{% render 'article-card', article: article %}{%- endfor -%}</div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Le journal de la <em>Omra</em>" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Guides pratiques pour préparer votre Omra : rites, ihram, miqat, Rawdah, lieux à visiter et valise." }
  ]
}
{% endschema %}
