<section class="final" style="min-height:100vh;display:grid;place-items:center;padding:60px 20px">
  <div class="final__ros" aria-hidden="true">{% render 'rosette' %}</div>
  <div class="wrap" style="position:relative">
    <div class="final__mark">{% render 'logo' %}</div>
    <p class="kicker" style="margin-top:20px">Bientôt</p>
    <h1 class="h-1 grad-text" style="margin-top:12px">La pureté de votre <em>plus beau</em> voyage.</h1>
    <p class="lede" style="margin:18px auto 30px">{{ shop.password_message | default: "Nos ihrams en coton d'Égypte arrivent. Laissez votre e-mail pour être prévenu." }}</p>
    {%- form 'customer', class: 'news', style: 'margin-inline:auto;border-color:var(--c-ink)' -%}
      <input type="hidden" name="contact[tags]" value="prelancement">
      <label class="visually-hidden" for="pw-email">E-mail</label>
      <input id="pw-email" type="email" name="contact[email]" placeholder="Votre e-mail" style="color:var(--c-ink)" required>
      <button type="submit" style="color:var(--c-teal)">Me prévenir</button>
    {%- endform -%}
    <details style="margin-top:40px"><summary style="cursor:pointer;color:var(--c-muted)">Accès boutique</summary>
      {%- form 'storefront_password' -%}{{ form.errors | default_errors }}
        <div class="field" style="max-width:320px;margin:16px auto"><label for="pw">Mot de passe</label><input id="pw" type="password" name="password"></div>
        <button class="btn" type="submit">Entrer</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Mot de passe" }
{% endschema %}
