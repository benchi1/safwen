<header class="page-head"><div class="wrap"><h1 class="h-display grad-text">Mes adresses</h1></div></header>
<section class="section" style="padding-top:56px"><div class="wrap wrap--narrow">
  {%- for address in customer.addresses -%}<div class="line" style="grid-template-columns:1fr">{{ address | format_address }}</div>{%- endfor -%}
  {%- form 'customer_address', customer.new_address -%}
    <h2 class="h-2" style="margin:30px 0 16px">Ajouter une adresse</h2>
    <div class="field"><label for="a1">Adresse</label><input id="a1" name="address[address1]" autocomplete="address-line1"></div>
    <div class="field"><label for="a-city">Ville</label><input id="a-city" name="address[city]" autocomplete="address-level2"></div>
    <div class="field"><label for="a-zip">Code postal</label><input id="a-zip" name="address[zip]" autocomplete="postal-code"></div>
    <input type="hidden" name="address[country]" value="France">
    <button class="btn" type="submit">Enregistrer</button>
  {%- endform -%}
  <p style="margin-top:28px"><a class="link" href="{{ routes.account_url }}">Retour au compte</a></p>
</div></section>
