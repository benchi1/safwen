<header class="page-head"><div class="wrap"><h1 class="h-1 grad-text">Commande {{ order.name }}</h1><p class="lede">{{ order.created_at | date: format: 'date' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p></div></header>
<section class="section" style="padding-top:56px"><div class="wrap wrap--narrow">
  {%- for item in order.line_items -%}<div class="line" style="grid-template-columns:1fr auto auto"><span>{{ item.title }}</span><span>× {{ item.quantity }}</span><span class="price">{{ item.final_line_price | money }}</span></div>{%- endfor -%}
  <div class="sum sum--t" style="margin-top:20px"><span>Total</span><span class="price">{{ order.total_price | money }}</span></div>
  <p style="margin-top:28px"><a class="link" href="{{ routes.account_url }}">Retour au compte</a></p>
</div></section>
